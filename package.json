{
  "name": "verygoodmelon.fun",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:integration": "vitest --run tests/integration",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:a11y": "vitest __tests__/accessibility",
    "test:e2e": "playwright test __tests__/e2e",
    "test:e2e:ui": "playwright test __tests__/e2e --ui",
    "test:e2e:headed": "playwright test __tests__/e2e --headed",
    "test:visual": "playwright test __tests__/visual",
    "test:visual:ui": "playwright test __tests__/visual --ui",
    "playwright:install": "npx playwright install",
    "qa": "npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "qa:full": "npm run typecheck && npm run lint && npm run build && npm run test && npm run test:e2e",
    "qa:quick": "npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@isoterik/react-word-cloud": "^1.3.0",
    "@met4citizen/talkinghead": "^1.7.0",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "openai": "^7.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simli-client": "^1.2.20",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.1",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "replicate": "^1.4.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
